# Agent API token. Use a long random value in real deployments.
AGENT_API_TOKEN=

# State backend: sqlite for local single-instance deployments, postgres for high concurrency or multi-instance deployments.
AGENT_STATE_BACKEND=sqlite

# SQLite default state file. Keep this under generated-images so Docker volume backups include metadata.
AGENT_SQLITE_PATH=generated-images/.agent-state/agent.sqlite

# PostgreSQL connection string. Required when AGENT_STATE_BACKEND=postgres.
# GPT_IMAGE_POSTGRES_PASSWORD=database-password
# AGENT_DATABASE_URL=postgres://gpt_image:database-password@postgres:5432/gpt_image_playground

# Request lease and idempotency retention.
AGENT_REQUEST_LEASE_MS=600000
AGENT_REQUEST_TTL_SECONDS=86400
AGENT_RECOVERY_INTERVAL_MS=30000

# Optional public base URL for OpenAPI clients.
# AGENT_PUBLIC_BASE_URL=http://localhost:4783

# Existing app configuration still applies.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
APP_PASSWORD=
